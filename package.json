{
  "name": "journeyman-projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Journeyman Projects — licensed project management module for the Journeyman Systems platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/devServer.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "tsx scripts/applySql.ts",
    "db:provision": "tsx src/provision.ts",
    "db:provision:built": "node dist/provision.js",
    "seed:demo": "tsx scripts/seedDemo.ts",
    "st:commission-probe": "tsx scripts/probeCommission.ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
